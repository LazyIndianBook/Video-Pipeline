{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExamLeaf storyboard beats (proposal)",
  "type": "object",
  "required": ["schema_version", "segment_id", "panels_per_grid", "panel_aspect", "panels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "segment_id": {"type": "string"},
    "panels_per_grid": {"const": 9},
    "panel_aspect": {"const": "9:16"},
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["grid", "panel", "scene_id", "beat_index", "description", "source"],
        "properties": {
          "grid": {"type": "integer", "minimum": 1},
          "panel": {"type": "integer", "minimum": 1, "maximum": 9},
          "scene_id": {"type": "string"},
          "beat_index": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "description": "What is on screen; derived from the approved script; facts named by fixture field, never typed values."},
          "cue_id": {"type": ["string", "null"], "description": "Cue sheet id once alignment exists."},
          "source": {"enum": ["code", "higgsfield"]},
          "hero_ref": {"type": ["string", "null"], "description": "Asset-library id of the character reference image (#48)."}
        }
      }
    }
  }
}
