{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examleaf.local/schemas/v2/locale_profile.json",
  "title": "ExamLeaf Locale Profile v2",
  "description": "Locale Profile (Architecture §8, CE-40; TEMPLATES §5). tts_admitted drives R1. Added 15 Oct 2026.",
  "$comment": "Commercial-term lint (CE-L1/RD-49; CE-26, CE-70; updated 15 Oct 2026): CI rejects, case-insensitively, any match of (price|pricing|paid|is_free|free_|premium|entitle|subscri|sku|paywall|unlock|monetis|monetiz|revenue|discount|coupon|tier|destination_resource|cta_destination|funnel|purchase_|checkout_|product_id|offer_|trial_|utm_|campaign_|affiliate_|activation_code|storefront) applied to every object key at every depth (including REN fields keys), every required entry, pattern key and enum or const value. Exempt: the editorial fields series_position, flagship and demo_kind, which carry no commercial meaning.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^reviewer/[a-z0-9][a-z0-9_.-]*$"
    },
    "tagged_wpm_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "multipleOf": 0.5
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "multipleOf": 0.5
        },
        "unit": {
          "const": "wpm"
        },
        "tag": {
          "type": "string",
          "enum": [
            "Recommendation",
            "Hypothesis",
            "Inherited",
            "Evidence"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "pilot_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "min",
        "max",
        "tag"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "tag": {
                "const": "Hypothesis"
              }
            }
          },
          "then": {
            "required": [
              "owner",
              "pilot_ref"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "locale_id": {
      "type": "string",
      "pattern": "^locale/[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "$ref": "#/definitions/semver"
    },
    "bcp47": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "script": {
      "type": "string",
      "pattern": "^[A-Z][a-z]{3}$"
    },
    "text_direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "font_stack": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "shaping_engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version_ref": {
          "type": "string",
          "pattern": "^harness/[a-z0-9][a-z0-9_.-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "name",
        "version_ref"
      ]
    },
    "numerals": {
      "enum": [
        "latn",
        "deva",
        "beng",
        "arab"
      ]
    },
    "spoken_math_policy": {
      "type": "string",
      "minLength": 1
    },
    "transliteration_table": {
      "type": "string",
      "minLength": 1
    },
    "code_mix_policy": {
      "type": "object",
      "propertyNames": {
        "pattern": "^level/[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "description": "none, or a code-mix pattern id"
          },
          "terms_kept_ref": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "$ref": "#/definitions/reviewer"
          }
        },
        "required": [
          "pattern"
        ]
      },
      "description": "Per level: the code-mix pattern. At a level with single_language_per_lesson: true, a pattern other than none needs approved_by from a child-development reviewer (Architecture §3.4 R4)."
    },
    "caption_line_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars_per_line": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "calibrate"
            }
          ]
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_chars_per_line",
        "max_lines"
      ]
    },
    "pacing_by_level": {
      "type": "object",
      "description": "Per level_id: a tagged wpm range for ordinary, dense and recap narration in this locale; owner the native subject editor. Absent = the Script Spec uses teacher_set for every beat (SCRIPTING §2; CE-40; added 15 Oct 2026, scripting-08).",
      "propertyNames": {
        "pattern": "^level/[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinary": {
            "$ref": "#/definitions/tagged_wpm_range"
          },
          "dense": {
            "$ref": "#/definitions/tagged_wpm_range"
          },
          "recap": {
            "$ref": "#/definitions/tagged_wpm_range"
          },
          "owner": {
            "$ref": "#/definitions/reviewer"
          }
        },
        "required": [
          "ordinary",
          "dense",
          "recap",
          "owner"
        ]
      }
    },
    "readability_method": {
      "const": "controlled_vocabulary_lists"
    },
    "lexicon_ref": {
      "type": "string",
      "pattern": "^lex/[a-z0-9][a-z0-9_.-]*(@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
    },
    "glossaries": {
      "type": "object",
      "propertyNames": {
        "pattern": "^family/[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "gl_glossary_passed": {
            "type": "boolean"
          },
          "approved_by": {
            "$ref": "#/definitions/reviewer"
          }
        },
        "required": [
          "ref",
          "gl_glossary_passed",
          "approved_by"
        ]
      }
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voice_ref": {
            "type": "string",
            "pattern": "^voice/[a-z0-9][a-z0-9_-]*(@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))?$"
          },
          "path": {
            "enum": [
              "A",
              "B"
            ]
          },
          "gl_voice_passed": {
            "type": "boolean"
          },
          "gl_voice_record": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "voice_ref",
          "path",
          "gl_voice_passed"
        ]
      }
    },
    "locale_gate_status": {
      "enum": [
        "passed",
        "pending"
      ]
    },
    "tts_admitted": {
      "type": "boolean"
    },
    "native_reviewer_ids": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reviewer"
      },
      "uniqueItems": true
    },
    "disclosure_text_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "locale_id",
    "version",
    "bcp47",
    "script",
    "text_direction",
    "font_stack",
    "shaping_engine",
    "numerals",
    "lexicon_ref",
    "voices",
    "locale_gate_status",
    "tts_admitted",
    "native_reviewer_ids",
    "disclosure_text_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "tts_admitted": {
            "const": true
          }
        },
        "required": [
          "tts_admitted"
        ]
      },
      "then": {
        "properties": {
          "voices": {
            "contains": {
              "properties": {
                "path": {
                  "const": "B"
                },
                "gl_voice_passed": {
                  "const": true
                }
              },
              "required": [
                "path",
                "gl_voice_passed"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locale_id": {
            "const": "locale/as-in"
          }
        },
        "required": [
          "locale_id"
        ]
      },
      "then": {
        "properties": {
          "tts_admitted": {
            "const": false
          }
        }
      },
      "$comment": "RD-42: Assamese is human-voiced until a TTS passes GL-voice and a lead decision changes this rule."
    }
  ]
}
