  "required": [
    "style_id",
    "version",
    "title",
    "purpose",
    "status",
    "extends",
    "layer",
    "selectable",
    "safety_classes_allowed",
    "levels_allowed",
    "formats_allowed",
    "aspects_supported",
    "token_bindings",
    "palette",
    "typography",
    "motion",
    "holds",
    "flash",
    "slot_types_implemented",
    "science_layer",
    "asset_sources_allowed",
    "cost",
    "references",
    "determinism",
    "qa",
    "edge_cases",
    "evidence"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "style_id": {
            "const": "style/base"
          }
        }
      },
      "then": {
        "properties": {
          "extends": {
            "maxItems": 0
          },
          "layer": {
            "const": "root"
          },
          "selectable": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "extends": {
            "minItems": 1,
            "contains": {
              "type": "string",
              "pattern": "^style/base@"
            }
          },
          "layer": {
            "enum": [
              "science",
              "expressive",
              "hybrid"
            ]
          },
          "selectable": {
            "const": true
          },
          "safety_classes_allowed": {
            "minItems": 1
          },
          "levels_allowed": {
            "minItems": 1
          },
          "formats_allowed": {
            "minItems": 1
          },
          "slot_types_implemented": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_classes_allowed": {
            "contains": {
              "const": "safety/ac0"
            }
          }
        },
        "required": [
          "safety_classes_allowed"
        ]
      },
      "then": {
        "properties": {
          "motion": {
            "properties": {
              "by_safety_class": {
                "required": [
                  "safety/ac0"
                ],
                "properties": {
                  "safety/ac0": {
                    "properties": {
                      "flash_policy": {
                        "const": "ac0_zero_flash"
                      },
                      "verbs_forbidden": {
                        "allOf": [
                          {
                            "contains": {
                              "const": "shake"
                            }
                          },
                          {
                            "contains": {
                              "const": "whip"
                            }
                          },
                          {
                            "contains": {
                              "const": "push_in"
                            }
                          },
                          {
                            "contains": {
                              "const": "count_up"
                            }
                          },
                          {
                            "contains": {
                              "const": "paper_burst"
                            }
                          },
                          {
                            "contains": {
                              "const": "parallax_drift"
                            }
                          },
                          {
                            "contains": {
                              "const": "orbit"
                            }
                          },
                          {
                            "contains": {
                              "const": "boil"
                            }
                          },
                          {
                            "contains": {
                              "const": "fixture_rotate"
                            }
                          }
                        ],
                        "$comment": "15 Oct 2026: registry section 2.2 ac0 column. Remove the boil item only by a Safety-class minor schema version after O-2 signs boil for ac0."
                      },
                      "pop_overshoot_max": {
                        "maximum": 1.4
                      },
                      "idle_rotation_deg_max": {
                        "properties": {
                          "value": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "maximum": 1.5
                          }
                        }
                      },
                      "boil_fps_max": {
                        "properties": {
                          "value": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "maximum": 8
                          }
                        }
                      },
                      "dark_surfaces": {
                        "const": "forbidden"
                      }
                    },
                    "required": [
                      "dark_surfaces",
                      "pop_overshoot_max",
                      "idle_rotation_deg_max"
                    ]
                  }
                }
              }
            }
          },
          "flash": {
            "properties": {
              "policy_by_class": {
                "required": [
                  "safety/ac0"
                ]
              }
            }
          },
          "asset_sources_allowed": {
            "not": {
              "contains": {
                "const": "generated_gated"
              }
            }
          },
          "levels_allowed": {
            "contains": {
              "enum": [
                "level/l1_2",
                "level/l3_5"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "aspects_supported": {
            "items": {
              "if": {
                "properties": {
                  "aspect": {
                    "const": "16x9"
                  }
                }
              },
              "then": {
                "properties": {
                  "token_status": {
                    "const": "approved"
                  }
                }
              },
              "else": {
                "properties": {
                  "token_status": {
                    "enum": [
                      "approved",
                      "placeholder_insets"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aspects_supported": {
            "contains": {
              "properties": {
                "aspect": {
                  "const": "16x9"
                }
              },
              "required": [
                "aspect"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "levels_allowed": {
            "contains": {
              "enum": [
                "level/ug",
                "level/pg",
                "level/adult_prof"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "const": "science"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "properties": {
          "motion": {
            "properties": {
              "vocabulary": {
                "not": {
                  "contains": {
                    "enum": [
                      "boil",
                      "idle",
                      "shake",
                      "whip",
                      "push_in",
                      "pan",
                      "parallax_drift",
                      "orbit",
                      "paper_burst",
                      "wiggle"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
