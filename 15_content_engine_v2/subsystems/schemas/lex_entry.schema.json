{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examleaf.local/schemas/v2/subsystems/lex_entry.json",
  "title": "ExamLeaf Pronunciation Lexicon (lex/) v1",
  "description": "Registry kind lex/ (CE-63): one pronunciation lexicon, lex/core.<locale> or lex/<family>.<locale>. Owner: the native-language editor of the locale; family lexicons are co-signed by the family's subject reviewer. Major = a spoken form changes; minor = an entry is added; patch = a non-spoken field changes; changes go through GR. See subsystems/VOICE_and_PERSONA_REGISTRY.md §3.6 (added 15 Oct 2026, voice-12).",
  "$comment": "Commercial-term lint (CE-L1/RD-49; CE-26, CE-70; 15 Oct 2026): CI rejects, case-insensitively, any match of (price|pricing|paid|is_free|free_|premium|entitle|subscri|sku|paywall|unlock|monetis|monetiz|revenue|discount|coupon|tier|destination_resource|cta_destination|funnel|purchase_|checkout_|product_id|offer_|trial_|utm_|campaign_|affiliate_|activation_code|storefront) applied to every object key at every depth, every required entry, pattern key and enum or const value. Exempt: series_position, flagship and demo_kind. Locale keys inside an entry are bare locale ids (the part after locale/).",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "family_ref": {
      "type": "string",
      "pattern": "^family/[a-z0-9_]+$"
    },
    "locale_ref": {
      "type": "string",
      "pattern": "^locale/[a-z0-9][a-z0-9_-]*$"
    },
    "reviewer_ref": {
      "type": "string",
      "pattern": "^reviewer/[a-z0-9][a-z0-9_.-]*$"
    }
  },
  "properties": {
    "lexicon_id": {
      "type": "string",
      "pattern": "^lex/[a-z0-9][a-z0-9_.-]*$"
    },
    "version": {
      "$ref": "#/definitions/semver"
    },
    "owner": {
      "$ref": "#/definitions/reviewer_ref"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "$ref": "#/definitions/family_ref"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "display": {
            "type": "string",
            "minLength": 1
          },
          "locales": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "spoken": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                },
                "allowed_variants": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "register_variants": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Keyed by persona variant."
                },
                "model_overrides": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Provider- or model-specific spellings (for example SSML phoneme strings), keyed by model/ id."
                },
                "editorially_checked": {
                  "type": "boolean"
                },
                "acoustic_approved": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^voice/[a-z0-9][a-z0-9_-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "accepted_audio_sha256": {
                  "$ref": "#/definitions/sha256"
                },
                "reviewer_id": {
                  "$ref": "#/definitions/reviewer_ref"
                }
              },
              "required": [
                "spoken",
                "caption",
                "editorially_checked"
              ]
            }
          }
        },
        "required": [
          "key",
          "family",
          "subject",
          "meaning",
          "display",
          "locales"
        ]
      }
    }
  },
  "required": [
    "lexicon_id",
    "version",
    "owner",
    "entries"
  ]
}
