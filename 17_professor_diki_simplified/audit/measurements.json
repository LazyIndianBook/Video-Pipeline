  "beats": [
   {
    "id": "b01",
    "slot": "hook.question_reveal",
    "start": 0.6,
    "end": 11.32,
    "audio_s": 10.72,
    "words": 27,
    "wpm": 151,
    "pause_after": 0.6,
    "think": 0.0,
    "text": "Hydrogen burns in oxygen to make water. Write it down: H two plus O two gives H two O. Count the atoms. Did an atom just vanish?"
   },
   {
    "id": "b02",
    "slot": "check.predict",
    "start": 11.92,
    "end": 16.24,
    "audio_s": 4.32,
    "words": 11,
    "wpm": 153,
    "pause_after": 0.3,
    "think": 5.0,
    "text": "Count the oxygen atoms on each side. Which side is short?"
   },
   {
    "id": "b03",
    "slot": "explain.ladder_step",
    "start": 21.54,
    "end": 36.34,
    "audio_s": 14.8,
    "words": 35,
    "wpm": 142,
    "pause_after": 0.4,
    "think": 0.0,
    "text": "Left: two oxygen atoms. Right: only one. But atoms are never created or destroyed in a reaction. That is the law of conservation of mass. So each element needs the same count on both sides."
   },
   {
    "id": "b04",
    "slot": "worked.step",
    "start": 36.74,
    "end": 48.66,
    "audio_s": 11.92,
    "words": 29,
    "wpm": 146,
    "pause_after": 0.6,
    "think": 0.0,
    "text": "Put a two in front of water. Oxygen: two and two. Hydrogen is four on the right, so put a two in front of hydrogen. Four and four. Balanced."
   },
   {
    "id": "b05",
    "slot": "misconception.confront",
    "start": 49.26,
    "end": 59.18,
    "audio_s": 9.92,
    "words": 23,
    "wpm": 139,
    "pause_after": 0.6,
    "think": 0.0,
    "text": "Why not write H two O two? That is hydrogen peroxide, a different substance. Change the coefficients in front, never the subscripts inside."
   },
   {
    "id": "b06",
    "slot": "recap.statement",
    "start": 59.78,
    "end": 66.5,
    "audio_s": 6.72,
    "words": 15,
    "wpm": 134,
    "pause_after": 0.6,
    "think": 0.0,
    "text": "Atoms are conserved, so count every element on both sides, and balance with coefficients only."
   },
   {
    "id": "b07",
