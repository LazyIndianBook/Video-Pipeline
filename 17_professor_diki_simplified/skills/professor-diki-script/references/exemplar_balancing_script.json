 "artefacts": {
  "scroll_test": "The equation printed in every textbook for rocket fuel loses an atom, and the obvious fix turns water into a different chemical.",
  "surprise": "Writing H₂O₂ 'balances' the oxygen and silently swaps water for hydrogen peroxide.",
  "outcome": "The learner balances a two-element equation by adding whole molecules (coefficients), never by changing a subscript, and makes the decisive step on Mg + O₂ → MgO.",
  "prerequisite_bridge": "H₂ is two hydrogen atoms joined; the small 2 belongs to the atom before it (CLM-subscript-meaning).",
  "fact_sheet": [
   {
    "fact": "H₂ + O₂ → H₂O; left O 2, right O 1",
    "node": "CLM-unbalanced-count"
   },
   {
    "fact": "atoms are conserved in a reaction",
    "node": "CLM-conservation"
   },
   {
    "fact": "only coefficients change; H₂O₂ is hydrogen peroxide",
    "node": "CLM-subscript-identity"
   },
   {
    "fact": "hydrogen burns with oxygen in rocket engines",
    "node": "CLM-rocket-hydrogen"
   },
   {
    "fact": "2Mg + O₂ → 2MgO",
    "node": "ASM-transfer-mgo"
   }
  ],
  "causal_chain": [
   "Atoms only rearrange; none appear or vanish.",
   "So both sides must show the same atoms.",
   "A new subscript makes a new substance, so add whole molecules instead.",
   "The number of whole molecules is the coefficient."
  ],
  "hooks": [
   {
    "kind": "pattern_interrupt",
    "text": "An oxygen atom just vanished. Watch.",
