  "beats_text": [
   {
    "id": "b01",
    "slot": "hook.question_reveal",
    "text": "What is Ohm's law? When electricity passes through a wire, something pushes it along. That push is called voltage, and we measure it in volts.",
    "headline": "What is Ohm's law?",
    "start": 0.3,
    "end": 9.608,
    "word_range": [
     0,
     25
    ],
    "energy": "high",
    "visual_op": [
     "PreserveObject",
     "TracePath",
     "MapSymbol",
     "Card"
    ],
    "emphasis_words": [
     "pushes",
     "voltage"
    ],
    "pause": {
     "beat": "b01",
     "purpose": "join",
     "seconds": 0.2,
     "start": 9.608,
     "end": 9.808
    }
   },
   {
    "id": "b02",
    "slot": "explain.definition",
    "text": "The flow is called current; this meter reads it in amperes.",
    "headline": "",
    "start": 9.808,
    "end": 13.38,
    "word_range": [
     25,
     36
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "MapSymbol",
     "TracePath"
    ],
    "insight_beat": true,
    "emphasis_words": [
     "meter"
    ],
    "pause": {
     "beat": "b02",
     "purpose": "join",
     "seconds": 0.2,
     "start": 13.38,
     "end": 13.58
    }
   },
   {
    "id": "b03",
    "slot": "explain.definition",
    "text": "Each wire holds the flow back; that is resistance, in ohms.",
    "headline": "",
    "start": 13.58,
    "end": 17.725,
    "word_range": [
     36,
     47
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "MapSymbol",
     "Emphasize"
    ],
    "emphasis_words": [
     "holds"
    ],
    "pause": {
     "beat": "b03",
     "purpose": "join",
     "seconds": 0.2,
     "start": 17.725,
     "end": 17.925
    }
   },
   {
    "id": "b04",
    "slot": "explain.definition",
    "text": "Ohm's law says the current goes up with the push, as long as the temperature stays the same.",
    "headline": "Ohm's law",
    "start": 17.925,
    "end": 22.913,
    "word_range": [
     47,
     65
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "Badge",
     "Reveal"
    ],
    "emphasis_words": [
     "temperature"
    ],
    "pause": {
     "beat": "b04",
     "purpose": "join",
     "seconds": 0.2,
     "start": 22.913,
     "end": 23.113
    }
   },
   {
    "id": "b05",
    "slot": "explain.formal",
    "text": "So voltage equals current times resistance: V equals I R. Then I is V over R, and R is V over I.",
    "headline": "Voltage equals current times resistance",
    "start": 23.113,
    "end": 30.178,
    "word_range": [
     65,
     87
    ],
    "energy": "low",
    "visual_op": [
     "EquationTransform",
     "MapSymbol"
    ],
    "emphasis_words": [
     "equals",
     "over"
    ],
    "pause": {
     "beat": "b05",
     "purpose": "join",
     "seconds": 0.2,
     "start": 30.178,
     "end": 30.378
    }
   },
   {
    "id": "b06",
    "slot": "explain.mechanism",
    "text": "Two volts over ten ohms gives point two amperes.",
    "headline": "",
    "start": 30.378,
    "end": 33.281,
    "word_range": [
     87,
     96
    ],
    "energy": "high",
    "visual_op": [
     "EquationTransform",
     "ChangeValue",
     "Card"
    ],
    "emphasis_words": [
     "point two"
    ],
    "pause": {
     "beat": "b06",
     "purpose": "join",
     "seconds": 0.2,
     "start": 33.281,
     "end": 33.481
    }
   },
   {
    "id": "b07",
    "slot": "explain.mechanism",
    "text": "Double the push to four volts, and the current doubles to point four.",
    "headline": "Double the push",
    "start": 33.481,
    "end": 37.332,
    "word_range": [
     96,
     109
    ],
    "energy": "peak",
    "visual_op": [
     "ChangeValue",
     "CompareStates",
     "Card"
    ],
    "emphasis_words": [
     "four"
    ],
    "pause": {
     "beat": "b07",
     "purpose": "land",
     "seconds": 0.5,
     "start": 37.332,
     "end": 37.832
    }
   },
   {
    "id": "b08",
    "slot": "worked.step",
    "text": "Keep two volts, double the resistance to twenty ohms, and the current halves to point one.",
    "headline": "Double the resistance",
    "start": 37.832,
    "end": 43.269,
    "word_range": [
     109,
     125
    ],
    "energy": "high",
    "visual_op": [
     "ChangeValue",
     "EquationTransform",
     "Card"
    ],
    "emphasis_words": [
     "twenty"
    ],
    "pause": {
     "beat": "b08",
     "purpose": "join",
     "seconds": 0.2,
     "start": 43.269,
     "end": 43.469
    }
   },
   {
    "id": "b09",
    "slot": "explain.condition",
    "text": "Voltage against current makes a straight line through zero. Its slope is the resistance.",
    "headline": "A straight line through zero",
    "start": 43.469,
    "end": 48.505,
    "word_range": [
     125,
     139
    ],
    "energy": "mid",
    "visual_op": [
     "TracePath",
     "Card",
     "ChangeValue"
    ],
    "emphasis_words": [
     "straight",
     "slope"
    ],
    "pause": {
     "beat": "b09",
     "purpose": "join",
     "seconds": 0.2,
     "start": 48.505,
     "end": 48.705
    }
   },
   {
    "id": "b10",
    "slot": "explain.condition",
    "text": "But a hot bulb's line bends, because its filament resists more.",
    "headline": "Line bends",
    "start": 48.705,
    "end": 52.524,
    "word_range": [
     139,
     150
    ],
    "energy": "high",
    "visual_op": [
     "SwapPart",
     "TracePath",
     "StrikeThrough"
    ],
    "emphasis_words": [
     "bends"
    ],
    "pause": {
     "beat": "b10",
