  "beats_text": [
   {
    "id": "b01",
    "slot": "hook.question_reveal",
    "text": "What is Ohm's law? When electricity passes through a wire, something pushes it along. That push is called voltage, and we measure it in volts.",
    "headline": "What is Ohm's law?",
    "start": 0.3,
    "end": 9.425,
    "word_range": [
     0,
     25
    ],
    "energy": "high",
    "visual_op": [
     "PreserveObject",
     "TracePath",
     "MapSymbol",
     "Card"
    ],
    "emphasis_words": [
     "pushes",
     "voltage"
    ],
    "pause": {
     "beat": "b01",
     "purpose": "join",
     "seconds": 0.2,
     "start": 9.425,
     "end": 9.625
    }
   },
   {
    "id": "b02",
    "slot": "explain.definition",
    "text": "The flow is called current; this meter reads it in amperes.",
    "headline": "",
    "start": 9.625,
    "end": 13.848,
    "word_range": [
     25,
     36
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "MapSymbol",
     "TracePath"
    ],
    "insight_beat": true,
    "emphasis_words": [
     "meter"
    ],
    "pause": {
     "beat": "b02",
     "purpose": "join",
     "seconds": 0.2,
     "start": 13.848,
     "end": 14.048
    }
   },
   {
    "id": "b03",
    "slot": "explain.definition",
    "text": "Each wire holds the flow back; that is resistance, in ohms.",
    "headline": "",
    "start": 14.048,
    "end": 17.569,
    "word_range": [
     36,
     47
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "MapSymbol",
     "Emphasize"
    ],
    "emphasis_words": [
     "holds"
    ],
    "pause": {
     "beat": "b03",
     "purpose": "join",
     "seconds": 0.2,
     "start": 17.569,
     "end": 17.769
    }
   },
   {
    "id": "b04",
    "slot": "explain.definition",
    "text": "Ohm's law says the current goes up with the push, as long as the temperature stays the same.",
    "headline": "Ohm's law",
    "start": 17.769,
    "end": 22.811,
    "word_range": [
     47,
     65
    ],
    "energy": "mid",
    "visual_op": [
     "Card",
     "Badge",
     "Reveal"
    ],
    "emphasis_words": [
     "temperature"
    ],
    "pause": {
     "beat": "b04",
     "purpose": "join",
     "seconds": 0.2,
     "start": 22.811,
     "end": 23.011
    }
   },
   {
    "id": "b05",
    "slot": "explain.formal",
    "text": "So voltage equals current times resistance: V equals I R. Then I is V over R, and R is V over I.",
    "headline": "Voltage equals current times resistance",
    "start": 23.011,
    "end": 31.615,
    "word_range": [
     65,
     87
    ],
    "energy": "low",
    "visual_op": [
     "EquationTransform",
     "MapSymbol"
    ],
    "emphasis_words": [
     "equals",
     "over"
    ],
    "pause": {
     "beat": "b05",
     "purpose": "join",
     "seconds": 0.2,
     "start": 31.615,
     "end": 31.815
    }
   },
   {
    "id": "b06",
    "slot": "explain.mechanism",
    "text": "Two volts over ten ohms gives point two amperes.",
    "headline": "",
    "start": 31.815,
    "end": 34.482,
    "word_range": [
     87,
     96
    ],
    "energy": "high",
    "visual_op": [
     "EquationTransform",
     "ChangeValue",
     "Card"
    ],
    "emphasis_words": [
     "point two"
    ],
    "pause": {
     "beat": "b06",
     "purpose": "join",
     "seconds": 0.2,
     "start": 34.482,
     "end": 34.682
    }
   },
   {
    "id": "b07",
    "slot": "explain.mechanism",
    "text": "Double the push to four volts, and the current doubles to point four.",
    "headline": "Double the push",
    "start": 34.682,
    "end": 38.348,
    "word_range": [
     96,
     109
    ],
    "energy": "peak",
    "visual_op": [
     "ChangeValue",
     "CompareStates",
     "Card"
    ],
    "emphasis_words": [
     "four"
    ],
    "pause": {
     "beat": "b07",
     "purpose": "land",
     "seconds": 0.5,
     "start": 38.348,
     "end": 38.848
    }
   },
   {
    "id": "b08",
    "slot": "worked.step",
    "text": "Keep two volts, double the resistance to twenty ohms, and the current halves to point one.",
    "headline": "Double the resistance",
    "start": 38.848,
    "end": 44.223,
    "word_range": [
     109,
     125
    ],
    "energy": "high",
    "visual_op": [
     "ChangeValue",
     "EquationTransform",
     "Card"
    ],
    "emphasis_words": [
     "twenty"
    ],
    "pause": {
     "beat": "b08",
     "purpose": "join",
     "seconds": 0.2,
     "start": 44.223,
     "end": 44.423
    }
   },
   {
    "id": "b09",
    "slot": "explain.condition",
    "text": "Voltage against current makes a straight line through zero. Its slope is the resistance.",
    "headline": "A straight line through zero",
    "start": 44.423,
    "end": 49.278,
    "word_range": [
     125,
     139
    ],
    "energy": "mid",
    "visual_op": [
     "TracePath",
     "Card",
     "ChangeValue"
    ],
    "emphasis_words": [
     "straight",
     "slope"
    ],
    "pause": {
     "beat": "b09",
     "purpose": "join",
     "seconds": 0.2,
     "start": 49.278,
     "end": 49.478
    }
   },
   {
    "id": "b10",
    "slot": "explain.condition",
    "text": "But a hot bulb's line bends, because its filament resists more.",
    "headline": "Line bends",
    "start": 49.478,
    "end": 53.29,
    "word_range": [
     139,
     150
    ],
    "energy": "high",
    "visual_op": [
     "SwapPart",
     "TracePath",
     "StrikeThrough"
    ],
    "emphasis_words": [
     "bends"
    ],
    "pause": {
     "beat": "b10",
     "purpose": "join",
     "seconds": 0.2,
     "start": 53.29,
     "end": 53.49
    }
   },
   {
