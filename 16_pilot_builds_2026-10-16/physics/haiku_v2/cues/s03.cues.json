    "id": "b03",
    "slot": "explain.ladder_step",
    "text": "At two volts the current is zero point two amperes. At four volts it is zero point four amperes. Twice the voltage, twice the current, at constant temperature.",
    "headline": "twice the current",
    "start": 0.093,
    "end": 11.133,
